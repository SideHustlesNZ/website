---
import BaseLayout from '../layouts/BaseLayout.astro';
import Faq from '../components/Faq.astro';
import PlansBlock from '../components/PlansBlock.astro';
import Community from '../components/Community.astro';
import { routes } from '../content/site';
import { hero, faqSection } from '../content/pricing';
---

<BaseLayout
  title="Pricing — Side Hustles NZ"
  description="One membership, full access from day one. Annual $149 a month or monthly $197, GST inclusive. Framework, weekly live coaching, NZ template vault, masterclasses and members-only events."
  page="pricing"
>
  <section class="pr-hero">
    <h1 class="sh-h1-page">{hero.h1[0]}<span class="sh-accent">{hero.h1[1]}</span></h1>
    <p class="pr-hero__lead">{hero.lead}</p>
  </section>

  <section id="plans" class="pr-plans-sec">
    <PlansBlock featured="annual" />
  </section>

  <section id="faqs" class="pr-faqs">
    <div class="sh-wrap--820 sh-center">
      <div class="sh-eyebrow sh-eyebrow--navy">{faqSection.eyebrow}</div>
      <h2 class="sh-h2-60 pr-faqs__h2">{faqSection.h2[0]}<span class="sh-accent">{faqSection.h2[1]}</span></h2>
    </div>

    <div class="sh-wrap--820 pr-faqs__list">
      <Faq faqs={faqSection.faqs} variant="boxed" id="pricing-faq" />
    </div>

    <div class="sh-wrap--820 sh-center pr-faqs__cta">
      <a class="pr-talk" href={routes.contact}>
        <span class="pr-talk__label">{faqSection.ctaLabel}</span>
        <span class="pr-talk__go" aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <Community background="#fff" />
</BaseLayout>

<style>
  .pr-hero { padding: clamp(48px, 8vw, 80px) clamp(20px, 4vw, 32px) 0; text-align: center; }
  .pr-hero__lead { margin: 22px auto 0; max-width: 52ch; font-size: 17px; line-height: 1.6; color: var(--grey-text); }

  .pr-plans-sec { padding: 44px clamp(20px, 4vw, 32px) 0; }

  .pr-faqs { padding: clamp(56px, 9vw, 96px) clamp(20px, 4vw, 32px) clamp(58px, 9vw, 100px); scroll-margin-top: 24px; }
  .pr-faqs__h2 { margin-top: 20px; }
  .pr-faqs__list { margin-top: 44px; }
  .pr-faqs__cta { margin-top: 40px; }
  .pr-talk {
    display: inline-flex; align-items: center; gap: 12px; background: var(--navy);
    padding: 8px 8px 8px 20px; border-radius: 999px; flex-wrap: wrap; justify-content: center;
  }
  .pr-talk:hover { background: var(--navy-deep); }
  .pr-talk__label { color: #fff; font-size: 15px; font-weight: 700; }
  .pr-talk__go {
    width: 36px; height: 36px; border-radius: 50%; background: var(--lime); color: var(--navy);
    display: flex; align-items: center; justify-content: center; font-size: 16px; font-weight: 700; flex: none;
  }
</style>
