---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Banner from '../../components/Banner.astro';
import { routes } from '../../content/site';
import { blogPage, posts, type Post } from '../../content/blog';

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
---

<BaseLayout title={`${post.title} — Side Hustles NZ`} description={post.excerpt} page="blog">
  <article class="bp">
    <div class="bp__head">
      <a class="bp__back" href={routes.blog}>{blogPage.allPosts}</a>
      <div class="bp__cat">{post.cat}</div>
      <h1 class="bp__title">{post.title}</h1>
      <p class="bp__excerpt">{post.excerpt}</p>
      <div class="bp__meta"><span>{post.date}</span><span class="bp__div"></span><span>{post.read}</span></div>
    </div>
    <div class="bp__img" role="img" aria-label="Post image"><span class="sh-ph__label">Post image</span></div>
    {post.body.length > 0 ? (
      <div class="bp__body">{post.body.map((p) => <p>{p}</p>)}</div>
    ) : (
      <div class="bp__placeholder"><span class="sh-ph__label">Article body</span></div>
    )}
  </article>

  <section class="bp-banner-sec">
    <Banner {...blogPage.banner} />
  </section>
</BaseLayout>

<style>
  .bp { padding: clamp(40px, 6vw, 64px) clamp(20px, 4vw, 32px) 0; }
  .bp__head { max-width: 760px; margin: 0 auto; display: flex; flex-direction: column; gap: 18px; }
  .bp__back { font-size: 13px; font-weight: 700; color: var(--navy); }
  .bp__cat { font-size: 11px; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; color: var(--navy); }
  .bp__title { margin: 0; font-weight: 800; font-size: clamp(34px, 6vw, 56px); line-height: 1.02; letter-spacing: -.03em; text-wrap: balance; }
  .bp__excerpt { margin: 0; font-size: 19px; line-height: 1.55; color: var(--grey-text); }
  .bp__meta { display: flex; align-items: center; gap: 10px; font-size: 12px; color: var(--grey-muted); }
  .bp__div { width: 1px; height: 11px; background: var(--border-blue-2); }
  .bp__img {
    max-width: 1000px; margin: 40px auto 0; aspect-ratio: 16/8; border-radius: 14px;
    background: repeating-linear-gradient(135deg, #E9E9E2 0 12px, #DEDED6 12px 24px);
    display: flex; align-items: center; justify-content: center;
  }
  .bp__placeholder {
    max-width: 760px; margin: 40px auto 0; min-height: 320px; border: 1px dashed #C9CCD9; border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
  }
  .bp__body { max-width: 760px; margin: 40px auto 0; }
  .bp__body p { margin: 0 0 20px; font-size: 17px; line-height: 1.75; color: var(--ink-soft); }
  .bp-banner-sec { padding: 64px clamp(20px, 4vw, 32px) 80px; }
</style>
