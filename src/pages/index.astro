---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import Community from '../components/Community.astro';
import PlansBlock from '../components/PlansBlock.astro';
import { links, routes } from '../content/site';
import { meta, hero, problem, how, included, curriculum, pricing, faqSection, story, finalCta } from '../content/home';
---

<BaseLayout title={meta.title} description={meta.description} page="home" header={false} sub={false}>
  <!-- 1. Hero -->
  <section class="hm-hero on-navy">
    <video
      class="hm-hero__video"
      aria-hidden="true"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      poster={hero.poster}
      src={hero.video}
    ></video>
    <div class="hm-hero__scrim" aria-hidden="true"></div>
    <div class="hm-hero__inner">
      <Header page="home" variant="navy" />
      <div class="hm-hero__copy">
        <div class="hm-hero__eyebrow">
          <span class="hm-rule" aria-hidden="true"></span>
          <span>{hero.eyebrow}</span>
          <span class="hm-rule" aria-hidden="true"></span>
        </div>
        <h1 class="sh-h1-hero hm-hero__h1">{hero.h1[0]}<br /><span class="sh-accent-lime">{hero.h1[1]}</span></h1>
        <p class="hm-hero__lead">{hero.lead}</p>
        <a class="sh-price-pill hm-hero__cta" href={links.checkout} target="_blank" rel="noopener">
          <span class="sh-price-pill__mark"></span>
          <span class="sh-price-pill__label">{hero.ctaLabel}</span>
          <span class="sh-price-pill__div"></span>
          <span class="sh-price-pill__price">{hero.ctaPrice}</span>
          <span class="sh-price-pill__go" aria-hidden="true">→</span>
        </a>
        <p class="hm-hero__fine">{hero.fine}</p>
        <div class="hm-press">
          <div class="hm-press__label">{hero.featuredLabel}</div>
          <div class="hm-press__names">
            {hero.featured.map((n) => <span>{n}</span>)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Problem -->
  <section id="problem" class="hm-problem">
    <div class="sh-wrap">
      <div class="sh-center">
        <h2 class="sh-h2-56">{problem.h2[0]}<br /><span class="sh-accent">{problem.h2[1]}</span></h2>
        <p class="hm-lead hm-problem__lead">{problem.lead}</p>
      </div>
      <div class="hm-problem__grid">
        {problem.cards.map((c) => (
          <div class="hm-pcard">
            <div class="hm-pcard__icon"><Icon name={c.icon as any} size={20} /></div>
            <div class="hm-pcard__title">{c.title}</div>
            <p class="hm-pcard__body">{c.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. How it works -->
  <section id="how" class="hm-navy on-navy">
    <div class="sh-wrap">
      <div class="hm-navy__head">
        <div>
          <div class="sh-eyebrow sh-eyebrow--lime">{how.eyebrow}</div>
          <h2 class="sh-h2-56 hm-navy__h2" style="max-width:14ch">{how.h2[0]}<span class="sh-accent-lime">{how.h2[1]}</span></h2>
        </div>
        <p class="hm-navy__lead">{how.lead}</p>
      </div>
      <div class="hm-steps">
        {how.steps.map((s) => (
          <div class="hm-step">
            <div class="hm-step__num">{s.num}</div>
            <h3 class="hm-step__title">{s.title}</h3>
            <p class="hm-step__body">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Everything included -->
  <section id="included" class="hm-included">
    <div class="sh-wrap">
      <div class="sh-center">
        <h2 class="sh-h2-56">{included.h2[0]}<br /><span class="sh-accent">{included.h2[1]}</span></h2>
        <p class="hm-included__lead">{included.lead}</p>
      </div>
      <div class="hm-included__grid">
        {included.cards.map((c) => (
          <div class="hm-icard">
            <div class="hm-icard__head">
              <div class="hm-icard__tile"><Icon name={c.icon as any} size={21} /></div>
              <div class="hm-icard__kicker">{c.kicker}</div>
            </div>
            <div class="hm-icard__title">{c.title}</div>
            <p class="hm-icard__body">{c.body}</p>
            <div class="hm-icard__points">
              {c.points.map((p) => (
                <div class="hm-point"><span class="hm-point__dot" aria-hidden="true"></span>{p}</div>
              ))}
            </div>
          </div>
        ))}
        <div class="hm-icard hm-icard--navy">
          <div class="hm-icard__head">
            <div class="hm-icard__tile hm-icard__tile--lime"><Icon name="bolt" size={21} /></div>
            <div class="hm-icard__kicker hm-icard__kicker--lime">{included.navyCard.kicker}</div>
          </div>
          <div class="hm-icard__title">{included.navyCard.title}</div>
          <p class="hm-icard__body hm-icard__body--on-navy">{included.navyCard.body}</p>
          <a class="hm-icard__cta" href={links.checkout} target="_blank" rel="noopener">
            <span class="sh-pill-lime">{included.navyCard.cta}</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Curriculum -->
  <section id="learn" class="hm-navy on-navy">
    <div class="sh-wrap">
      <div class="hm-navy__head">
        <div>
          <div class="sh-eyebrow sh-eyebrow--lime">{curriculum.eyebrow}</div>
          <h2 class="sh-h2-56 hm-navy__h2" style="max-width:16ch">{curriculum.h2[0]}<span class="sh-accent-lime">{curriculum.h2[1]}</span></h2>
        </div>
        <p class="hm-navy__lead">{curriculum.lead}</p>
      </div>
      <div class="hm-curr">
        {curriculum.rows.map((r, i) => (
          <div class="hm-curr__row">
            <div class="hm-curr__num">{String(i + 1).padStart(2, '0')}</div>
            <div>
              <div class="hm-curr__title">{r.title}</div>
              <p class="hm-curr__body">{r.body}</p>
              <div class="hm-curr__out">→ {r.outcome}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. Community -->
  <Community background="#EEF1FA" />

  <!-- 7. Pricing -->
  <section id="pricing" class="hm-pricing">
    <h2 class="sh-h2-60">{pricing.h2[0]}<span class="sh-accent">{pricing.h2[1]}</span></h2>
    <p class="hm-pricing__lead">{pricing.lead}</p>
    <div class="hm-pricing__shell">
      <PlansBlock featured="monthly" showAnnual={pricing.showAnnual} />
    </div>
  </section>

  <!-- 8. FAQs -->
  <section id="faqs" class="hm-faqs">
    <div class="sh-eyebrow">{faqSection.eyebrow}</div>
    <h2 class="sh-h2-56 hm-faqs__h2">{faqSection.h2}</h2>
    <div class="sh-wrap--820 hm-faqs__list">
      <Faq faqs={faqSection.faqs} variant="plain" id="home-faq" />
      <p class="hm-faqs__podcast">{faqSection.podcastLead} <a href={routes.library}>{faqSection.podcastLink}</a></p>
    </div>
  </section>

  <!-- 9. Our story -->
  <section id="about" class="hm-story">
    <div class="hm-story__grid">
      <img class="hm-story__photo" src="/images/founder.jpg" alt={story.photoAlt} loading="lazy" />
      <div>
        <div class="sh-eyebrow">{story.eyebrow}</div>
        <h2 class="sh-h2-48 hm-story__h2">{story.h2[0]}<br /><span class="sh-accent">{story.h2[1]}</span></h2>
        <div class="hm-story__body">
          {story.paragraphs.map((p) => <p>{p}</p>)}
        </div>
        <div class="hm-story__byline">
          <div class="hm-story__avatar" aria-hidden="true"></div>
          <div>
            <div class="hm-story__name">{story.name}</div>
            <div class="hm-story__role">{story.role}</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 10. Final CTA -->
  <section class="hm-final on-navy">
    <div class="hm-final__glow" aria-hidden="true"></div>
    <div class="hm-final__inner">
      <div class="sh-eyebrow sh-eyebrow--lime">{finalCta.eyebrow}</div>
      <h2 class="sh-h2-68 hm-final__h2">{finalCta.h2[0]}<br />{finalCta.h2[1]}<span class="sh-accent-lime">{finalCta.h2[2]}</span></h2>
      <p class="hm-final__lead">{finalCta.lead}</p>
      <a class="sh-price-pill hm-final__cta" href={links.checkout} target="_blank" rel="noopener">
        <span class="sh-price-pill__mark"></span>
        <span class="sh-price-pill__label">{finalCta.cta}</span>
        <span class="sh-price-pill__go" aria-hidden="true">→</span>
      </a>
      <p class="hm-final__fine">{finalCta.fine}</p>
    </div>
  </section>
</BaseLayout>

<script>
  // iOS and some browsers need a nudge to autoplay; ignore a refused play().
  const v = document.querySelector<HTMLVideoElement>('.hm-hero__video');
  if (v) {
    v.muted = true;
    v.play()?.catch(() => {});
  }
</script>

<style>
  .hm-hero { position: relative; background: var(--navy); padding: 0 0 80px; overflow: hidden; }
  .hm-hero__video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hm-hero__scrim { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(10,10,50,.55), rgba(10,10,50,.85)); }
  .hm-hero__inner { position: relative; }
  .hm-hero__copy {
    text-align: center; max-width: 1180px; margin: 0 auto;
    padding: clamp(88px, 12vw, 150px) clamp(20px, 4vw, 32px) 0;
  }
  .hm-hero__eyebrow {
    display: flex; align-items: center; justify-content: center; gap: 12px; margin-bottom: 26px;
    font-size: 11px; letter-spacing: .3em; text-transform: uppercase; color: var(--lime); font-weight: 700;
  }
  .hm-rule { width: 26px; height: 1px; background: rgba(204,255,0,.6); flex: none; }
  .hm-hero__h1 { color: #fff; }
  .hm-hero__lead { margin: 32px auto 0; max-width: 60ch; font-size: 17px; line-height: 1.55; color: rgba(255,255,255,.8); }
  .hm-hero__cta { margin-top: 36px; }
  .hm-hero__fine { margin: 16px 0 0; font-size: 12px; color: rgba(255,255,255,.6); }
  .hm-press { margin-top: 56px; display: flex; flex-direction: column; align-items: center; gap: 14px; }
  .hm-press__label { font-size: 10px; font-weight: 700; letter-spacing: .28em; text-transform: uppercase; color: rgba(255,255,255,.5); }
  .hm-press__names { display: flex; justify-content: center; align-items: center; gap: 12px 32px; flex-wrap: wrap; }
  .hm-press__names span { font-size: 14px; font-weight: 800; letter-spacing: .02em; text-transform: uppercase; color: rgba(255,255,255,.6); }

  .hm-problem {
    background: var(--tint-blue); border-radius: 32px 32px 0 0; margin-top: -32px; position: relative;
    padding: clamp(56px, 9vw, 96px) clamp(20px, 4vw, 32px) clamp(58px, 9vw, 100px);
  }
  .hm-lead { margin: 24px auto 0; max-width: 58ch; font-size: 17px; line-height: 1.6; color: var(--grey-text); }
  .hm-problem__grid {
    display: grid; gap: 18px; margin-top: 52px;
    grid-template-columns: repeat(auto-fit, minmax(max(min(100%, 300px), calc((100% - 36px) / 3)), 1fr));
  }
  .hm-pcard { background: #fff; border: 1px solid var(--border-blue-2); border-radius: 18px; padding: 26px 24px; }
  .hm-pcard__icon {
    width: 38px; height: 38px; border-radius: 11px; background: var(--navy); color: var(--lime);
    display: flex; align-items: center; justify-content: center;
  }
  .hm-pcard__title { margin-top: 16px; font-size: 17px; font-weight: 700; letter-spacing: -.01em; }
  .hm-pcard__body { margin: 8px 0 0; font-size: 14px; line-height: 1.6; color: var(--grey-text); }

  .hm-navy { background: var(--navy); color: #fff; padding: clamp(60px, 10vw, 110px) clamp(20px, 4vw, 32px); }
  .hm-navy__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 40px; flex-wrap: wrap; }
  .hm-navy__h2 { margin-top: 18px; }
  .hm-navy__lead { margin: 0; max-width: 42ch; font-size: 16px; line-height: 1.6; color: rgba(255,255,255,.72); }
  .hm-steps {
    display: grid; gap: 32px 24px; margin-top: 60px;
    grid-template-columns: repeat(auto-fit, minmax(max(min(100%, 260px), calc((100% - 48px) / 3)), 1fr));
  }
  .hm-step { border-top: 1px solid rgba(204,255,0,.4); padding-top: 24px; }
  .hm-step__num { font-size: 14px; font-weight: 800; color: var(--lime); letter-spacing: .08em; }
  .hm-step__title { margin: 16px 0 0; font-size: 26px; font-weight: 700; letter-spacing: -.025em; }
  .hm-step__body { margin: 12px 0 0; font-size: 15px; line-height: 1.6; color: rgba(255,255,255,.7); }

  .hm-included { background: #fff; padding: clamp(58px, 9vw, 100px) clamp(20px, 4vw, 32px); }
  .hm-included__lead { margin: 22px auto 0; max-width: 52ch; font-size: 16px; line-height: 1.6; color: var(--grey-text); }
  .hm-included__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 18px; margin-top: 52px; }
  .hm-icard {
    background: var(--card-blue); border: 1px solid var(--border-blue); border-radius: 20px;
    padding: 30px 28px; display: flex; flex-direction: column;
  }
  .hm-icard:not(.hm-icard--navy):hover { border-color: var(--navy); }
  .hm-icard--navy { background: var(--navy); border-color: var(--navy); color: #fff; }
  .hm-icard__head { display: flex; align-items: center; gap: 12px; }
  .hm-icard__tile {
    width: 40px; height: 40px; border-radius: 12px; background: var(--navy); color: var(--lime);
    display: flex; align-items: center; justify-content: center; flex: none;
  }
  .hm-icard__tile--lime { background: var(--lime); color: var(--navy); }
  .hm-icard__kicker { font-size: 11px; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; color: var(--navy); }
  .hm-icard__kicker--lime { color: var(--lime); }
  .hm-icard__title { margin-top: 18px; font-size: 21px; font-weight: 700; letter-spacing: -.02em; }
  .hm-icard__body { margin: 10px 0 0; font-size: 14px; line-height: 1.65; color: var(--grey-text); }
  .hm-icard__body--on-navy { color: rgba(255,255,255,.75); }
  .hm-icard__points { display: flex; flex-direction: column; gap: 8px; margin-top: 16px; }
  .hm-point { display: flex; gap: 9px; align-items: flex-start; font-size: 13px; color: var(--ink); }
  .hm-point__dot {
    flex: none; margin-top: 6px; width: 6px; height: 6px; border-radius: 50%;
    background: var(--lime); box-shadow: 0 0 0 1px var(--navy);
  }
  .hm-icard__cta { display: block; margin-top: auto; padding-top: 22px; }
  .hm-icard__cta .sh-pill-lime { display: block; width: 100%; font-size: 15px; padding: 14px; }
  .hm-icard__cta:hover .sh-pill-lime { background: var(--lime-hover); }

  .hm-curr { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); gap: 0 48px; margin-top: 56px; }
  .hm-curr__row { display: flex; gap: 20px; align-items: baseline; border-top: 1px solid rgba(255,255,255,.16); padding: 22px 0; }
  .hm-curr__num { flex: none; font-size: 14px; font-weight: 800; color: var(--lime); letter-spacing: .08em; }
  .hm-curr__title { font-size: 20px; font-weight: 700; letter-spacing: -.02em; }
  .hm-curr__body { margin: 8px 0 0; font-size: 14px; line-height: 1.6; color: rgba(255,255,255,.7); }
  .hm-curr__out { margin-top: 10px; font-size: 13px; font-weight: 700; color: var(--lime); }

  .hm-pricing { background: #fff; padding: clamp(56px, 9vw, 96px) clamp(20px, 4vw, 32px); text-align: center; }
  .hm-pricing__lead { margin: 18px 0 0; font-size: 16px; color: var(--grey-text); }
  .hm-pricing__shell { margin-top: 46px; }

  .hm-faqs { background: #fff; padding: clamp(56px, 9vw, 96px) clamp(20px, 4vw, 32px); text-align: center; }
  .hm-faqs__h2 { margin: 18px 0 44px; }
  .hm-faqs__list { text-align: left; }
  .hm-faqs__podcast { margin: 28px 0 0; font-size: 14px; color: var(--grey-text); text-align: center; }
  .hm-faqs__podcast a { font-weight: 700; }

  .hm-story { background: #fff; padding: clamp(58px, 9vw, 100px) clamp(20px, 4vw, 32px); }
  .hm-story__grid {
    max-width: 1100px; margin: 0 auto; display: grid; align-items: center; gap: clamp(34px, 5vw, 56px);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
  }
  .hm-story__photo {
    display: block; width: 100%; aspect-ratio: 4/5; object-fit: cover; object-position: 50% 30%;
    border-radius: 20px; background: #E9E9E2;
  }
  .hm-story__h2 { margin-top: 18px; }
  .hm-story__body { display: flex; flex-direction: column; gap: 16px; margin-top: 24px; }
  .hm-story__body p { margin: 0; font-size: 16px; line-height: 1.7; color: var(--ink-soft); }
  .hm-story__byline { display: flex; align-items: center; gap: 12px; margin-top: 28px; }
  .hm-story__avatar {
    width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--navy); flex: none;
    background: repeating-linear-gradient(135deg, #E9E9E2 0 7px, #DEDED6 7px 14px);
  }
  .hm-story__name { font-size: 14px; font-weight: 700; }
  .hm-story__role { font-size: 12px; color: var(--grey-light); }

  .hm-final {
    background: var(--navy); color: #fff; text-align: center; position: relative; overflow: hidden;
    padding: clamp(64px, 11vw, 120px) clamp(20px, 4vw, 32px);
  }
  .hm-final__glow { position: absolute; inset: -40% 25% auto; height: 90%; background: radial-gradient(circle, rgba(204,255,0,.16), transparent 65%); }
  .hm-final__inner { position: relative; }
  .hm-final__h2 { margin-top: 22px; }
  .hm-final__lead { margin: 26px auto 0; max-width: 50ch; font-size: 17px; line-height: 1.6; color: rgba(255,255,255,.8); }
  .hm-final__cta { margin-top: 38px; }
  .hm-final__fine { margin: 20px 0 0; font-size: 12px; color: rgba(255,255,255,.6); }
</style>
