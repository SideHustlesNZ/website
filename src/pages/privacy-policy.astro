---
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalDoc from '../components/LegalDoc.astro';
import { routes } from '../content/site';
import { hero, toc, sections, contactBox } from '../content/privacy';
---

<BaseLayout
  title="Privacy policy — Side Hustles NZ"
  description="What we collect, why we collect it, who else sees it, and how to get it back or deleted. Written to meet the New Zealand Privacy Act 2020."
  page="privacy"
>
  <LegalDoc hero={hero} toc={toc} sections={sections} contactBox={contactBox} contactLink={routes.terms} ruleFirst={false} />
</BaseLayout>
