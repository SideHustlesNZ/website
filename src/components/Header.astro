---
import { site, links, nav, headerCta, type NavKey } from '../content/site';

interface Props {
  page: NavKey;
  variant?: 'navy' | 'light';
}

const { page, variant = 'light' } = Astro.props;
const items = nav[page];
const cta = headerCta[page];
const ctaClass = variant === 'navy' ? 'sh-pill-lime' : 'sh-pill-navy';
---

<div class={`sh-header sh-header--${variant}`}>
  <a href="/" class="sh-brand" aria-label={`${site.name} home`}>
    <span class="sh-brand__mark"></span>
    <span class="sh-brand__word">{site.wordmark}</span>
  </a>

  <nav class="sh-nav" aria-label="Main">
    {items.map((i) => (
      <a href={i.href} aria-current={i.current ? 'page' : undefined}>{i.label}</a>
    ))}
  </nav>

  <div class="sh-header__right">
    <a class="sh-login" href={links.skool}>Log in</a>
    <a class={`sh-header__cta ${ctaClass}`} href={cta}>Join the community</a>

    <button
      type="button"
      class="sh-bell"
      data-subscribe-open
      aria-label="Subscribe to updates"
      title="Subscribe to updates"
    >
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8a6 6 0 1 0-12 0c0 5-2 6-2 6h16s-2-1-2-6"></path><path d="M10.3 20a2 2 0 0 0 3.4 0"></path></svg>
      <span class="sh-bell__dot"></span>
    </button>

    <button type="button" class="sh-burger" data-menu-open aria-label="Open menu" aria-expanded="false" aria-controls="sh-menu">
      <span class="sh-burger__bars" aria-hidden="true"><i></i><i></i><i></i></span>
    </button>
  </div>
</div>

<!-- Mobile menu: full-screen navy sheet. The lime/navy Join button stays in the
     bar itself at every width, so signing up from a phone never needs this. -->
<div class="sh-sheet" id="sh-menu" data-open="false" role="dialog" aria-modal="true" aria-label="Menu">
  <div class="sh-sheet__top">
    <span class="sh-brand">
      <span class="sh-brand__mark"></span>
      <span class="sh-brand__word" style="color:#fff">{site.wordmark}</span>
    </span>
    <button type="button" class="sh-sheet__close" data-menu-close aria-label="Close menu">&#10005;</button>
  </div>

  <nav class="sh-sheet__links" aria-label="Mobile">
    {items.map((i) => <a href={i.href}>{i.label}</a>)}
    <a href="/contact/">Contact</a>
  </nav>

  <div class="sh-sheet__foot">
    <a class="sh-sheet__cta sh-pill-lime" href={cta}>Join the community</a>
    <a class="sh-sheet__login" href={links.skool}>Log in</a>
  </div>
</div>

<script>
  const sheet = document.getElementById('sh-menu');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-menu-close]');

  function setMenu(open: boolean) {
    if (!sheet || !openBtn) return;
    sheet.dataset.open = String(open);
    openBtn.setAttribute('aria-expanded', String(open));
    document.body.dataset.locked = String(open);
    if (open) sheet.querySelector<HTMLAnchorElement>('a')?.focus();
    else openBtn.focus();
  }

  openBtn?.addEventListener('click', () => setMenu(true));
  closeBtn?.addEventListener('click', () => setMenu(false));
  sheet?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && sheet?.dataset.open === 'true') setMenu(false);
  });
  // if the window grows back to desktop width, drop the sheet
  window.addEventListener('resize', () => {
    if (window.innerWidth > 900 && sheet?.dataset.open === 'true') setMenu(false);
  });
</script>
